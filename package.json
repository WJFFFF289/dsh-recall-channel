{
  "name": "dsh-recall-channel",
  "version": "1.1.2",
  "description": "Recall channel for DeepSeek Harness: search the durable session log (including content shadowed by compaction) and restore it on demand.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "安装说明.txt",
    "回滚到v1.0.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/mechanics.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "context",
    "compaction",
    "recall"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2"
  }
}
