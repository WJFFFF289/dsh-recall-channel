{
  "name": "dsh-recall-channel",
  "version": "1.3.0",
  "description": "Recall channel for DeepSeek Harness: search and restore compacted history within a session, recall content across sessions in the same workspace, search all workspace sessions at once, keep a writable shared memory file, and offer to resume the workspace when a new session starts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJFFFF289/dsh-recall-channel.git"
  },
  "homepage": "https://github.com/WJFFFF289/dsh-recall-channel#readme",
  "bugs": {
    "url": "https://github.com/WJFFFF289/dsh-recall-channel/issues"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "install.cmd",
    "install.ps1",
    "README.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "安装说明.txt",
    "回滚到v1.0.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/mechanics.mjs && node test/onboard-memory.mjs && node test/scale.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "context",
    "compaction",
    "recall"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2 || ^0.2.0-rc.1"
  }
}
